# Copy this file to .env and fill in the values

# Required: OpenRouter API key (https://openrouter.ai)
OPENROUTER_API_KEY=

# Optional: override the default model
# OPENROUTER_MODEL=google/gemini-2.5-pro

# Optional: grouping strategy for the Connections solver: openrouter (default) or jev
# SOLVER=jev

# Required for SOLVER=jev: TypeSafe API key (https://console.typesafe.ai)
# TYPESAFE_API_KEY=
# Optional: pin a Jev version (default: jev-latest)
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0
# Optional: Jev question design: beam (staged Choice questions, default) or pairwise (120 Nouls)
# JEV_STRATEGY=beam

# Required for /solve endpoint: Lightpanda Cloud token
LIGHTPANDA_TOKEN=

# Optional: SQLite database path (default: /data/scores.db)
# DB_PATH=/data/scores.db

# Optional: public base URL for solver images (e.g. https://apps.yehudab.com)
# PUBLIC_SOLVER_URL=https://apps.yehudab.com
